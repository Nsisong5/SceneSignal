{
  "$defs": {
    "AssetRef": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "uri"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "ChannelContext": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "channel_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel Id"
        },
        "conventions": {
          "items": {
            "type": "string"
          },
          "title": "Conventions",
          "type": "array"
        },
        "style_guidance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style Guidance"
        }
      },
      "title": "ChannelContext",
      "type": "object"
    },
    "RelatedAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "relation": {
          "enum": [
            "source_clip",
            "sibling",
            "derived_from"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "relation"
      ],
      "title": "RelatedAsset",
      "type": "object"
    },
    "SourceSegment": {
      "additionalProperties": false,
      "properties": {
        "end_seconds": {
          "minimum": 0.0,
          "title": "End Seconds",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "order_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Index"
        },
        "segment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Segment Id",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0.0,
          "title": "Start Seconds",
          "type": "number"
        }
      },
      "required": [
        "segment_id",
        "start_seconds",
        "end_seconds"
      ],
      "title": "SourceSegment",
      "type": "object"
    },
    "SourceTimeline": {
      "additionalProperties": false,
      "properties": {
        "segments": {
          "items": {
            "$ref": "#/$defs/SourceSegment"
          },
          "title": "Segments",
          "type": "array"
        }
      },
      "title": "SourceTimeline",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Asset Id",
      "type": "string"
    },
    "asset_ref": {
      "$ref": "#/$defs/AssetRef"
    },
    "channel_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChannelContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contract_version": {
      "pattern": "^\\d+\\.\\d+$",
      "title": "Contract Version",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "extraction_profile": {
      "enum": [
        "quick",
        "standard",
        "thorough"
      ],
      "title": "Extraction Profile",
      "type": "string"
    },
    "global_prompt": {
      "anyOf": [
        {
          "maxLength": 8000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Global Prompt"
    },
    "job_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "order_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order Index"
    },
    "production_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Production Id"
    },
    "provider_config_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Config Ref"
    },
    "related_assets": {
      "items": {
        "$ref": "#/$defs/RelatedAsset"
      },
      "title": "Related Assets",
      "type": "array"
    },
    "requested_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Requested Capabilities",
      "type": "array"
    },
    "rerun_of": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rerun Of"
    },
    "scene_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scene Id"
    },
    "source_kind": {
      "enum": [
        "generated",
        "user_upload",
        "imported"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_prompt": {
      "anyOf": [
        {
          "maxLength": 8000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Prompt"
    },
    "source_timeline": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceTimeline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transcript_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssetRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "user_preferences_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Preferences Ref"
    }
  },
  "required": [
    "contract_version",
    "job_id",
    "asset_id",
    "source_kind",
    "asset_ref",
    "extraction_profile"
  ],
  "title": "ExtractionJob",
  "type": "object"
}
